# Names only. Real values live in each environment's secret store.

# Core
NODE_ENV=development
# App role (subject to RLS). Migrations use the owner role.
DATABASE_URL=postgres://atrium_app:atrium_app@localhost:5432/atrium
DATABASE_ADMIN_URL=postgres://atrium:atrium@localhost:5432/atrium
ATRIUM_APP_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connectors
N8N_ENCRYPTION_KEY=
INGESTION_API_TOKEN=

# Providers (added as each connector lands)
TOAST_EXPORT_BUCKET=
METRICOOL_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Email leaves through Resend. In development, leave the key and the sender empty to record mail
# without sending it. Outside development the API and the agents service refuse to start without them.
RESEND_API_KEY=
EMAIL_FROM=
# Resend signs its webhooks; the API needs the secret to accept them (whsec_...).
RESEND_WEBHOOK_SECRET=

# Agents: Host's own model key, shared by its subagents. Leave the key empty to run without a
# model; Sentiment then answers "rejected" and Recovery still works from the rating.
# A model id ending in :free is for development and test data only: it is refused unless
# NODE_ENV is development or test, or HOST_ALLOW_FREE=true. See ADR 0019 and 0020.
HOST_LLM_API_KEY=
HOST_MODEL_DEFAULT=
HOST_MODEL_SENTIMENT=
HOST_ALLOW_FREE=
# The agents service, and how the worker finds it. The token is any random string of 32 characters or more.
AGENTS_PORT=3005
AGENTS_SERVICE_TOKEN=
AGENTS_URL=http://localhost:3005

# Observability
SENTRY_DSN=

# Sign-in and the screens
AGENCY_SLUG=atrium
TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3003
API_URL=http://localhost:3001

# Surveys: the Hub is where guests open links and QR codes
HUB_URL=http://localhost:3004
PLATFORM_URL=http://localhost:3003
PUBLIC_BASE_URL=http://localhost:3004
SURVEY_SECRET=

# The stamp card (CRM loyalty). Without LOYALTY_SECRET the /v1/loyalty and /api/loyalty routes are not mounted.
# LOYALTY_SECRET signs the printed join QR tokens and hashes the device cookie: a random string of 32+ characters.
LOYALTY_SECRET=
# Set to 1 only when a proxy you control sets X-Forwarded-For; otherwise the client IP is the socket address.
TRUST_PROXY=
# The public origin of the card app (apps/qr-card, delivery B); the printable join QR points to <QR_CARD_URL>/j/<token>.
QR_CARD_URL=http://localhost:3006
# The card app (qr-card) reaches the API through a same-origin proxy. LOYALTY_PROXY_SECRET is the same value on the API
# and on qr-card (32+ characters): with TRUST_PROXY on, the API believes X-Forwarded-For only when this secret matches.
LOYALTY_PROXY_SECRET=
# How many trusted proxies sit in front of qr-card in production. 0 means none: every guest then shares one set of limits.
QR_CARD_PROXY_HOPS=0
