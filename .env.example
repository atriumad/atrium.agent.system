# Names only. Real values live in each environment's secret store.

# Core
NODE_ENV=development
# App role (subject to RLS). Migrations use the owner role.
DATABASE_URL=postgres://atrium_app:atrium_app@localhost:5432/atrium
DATABASE_ADMIN_URL=postgres://atrium:atrium@localhost:5432/atrium
ATRIUM_APP_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connectors
N8N_ENCRYPTION_KEY=
INGESTION_API_TOKEN=

# Providers (added as each connector lands)
TOAST_EXPORT_BUCKET=
METRICOOL_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_FROM_DOMAIN=

# Agents: Host's own model key, shared by its subagents. Leave the key empty to run without a
# model; Sentiment then answers "rejected" and Recovery still works from the rating.
# A model id ending in :free is for development and test data only: it is refused unless
# NODE_ENV is development or test, or HOST_ALLOW_FREE=true. See ADR 0019 and 0020.
HOST_LLM_API_KEY=
HOST_MODEL_DEFAULT=
HOST_MODEL_SENTIMENT=
HOST_ALLOW_FREE=
# The agents service, and how the worker finds it
AGENTS_PORT=3005
AGENTS_SERVICE_TOKEN=
AGENTS_URL=http://localhost:3005

# Observability
SENTRY_DSN=

# Sign-in and the screens
AGENCY_SLUG=atrium
TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3003
API_URL=http://localhost:3001

# Surveys: the Hub is where guests open links and QR codes
HUB_URL=http://localhost:3004
PLATFORM_URL=http://localhost:3003
PUBLIC_BASE_URL=http://localhost:3004
SURVEY_SECRET=
