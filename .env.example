# Names only. Real values live in each environment's secret store.

# Core
NODE_ENV=development
# App role (subject to RLS). Migrations use the owner role.
DATABASE_URL=postgres://atrium_app:atrium_app@localhost:5432/atrium
DATABASE_ADMIN_URL=postgres://atrium:atrium@localhost:5432/atrium
ATRIUM_APP_PASSWORD=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Connectors
N8N_ENCRYPTION_KEY=
INGESTION_API_TOKEN=

# Providers (added as each connector lands)
TOAST_EXPORT_BUCKET=
METRICOOL_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_APP_ID=
META_ADS_APP_SECRET=

# Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_FROM_DOMAIN=

# Agents
ANTHROPIC_API_KEY=

# Observability
SENTRY_DSN=

# Sign-in and the screens
AGENCY_SLUG=atrium
TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3003
API_URL=http://localhost:3001
